*.rds filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.csv filter=lfs diff=lfs merge=lfs -text

# Small hand-built analysis inputs (group mapping, ISO mapping, elasticities;
# under 7 KB each). Nothing in the model reproduces without them, so they are
# stored as ordinary git blobs rather than LFS pointers and survive a clone
# made without LFS. -text keeps bytes byte-exact. The bulk FAOSTAT inputs and
# all *.rds / *.pkl data keep their LFS routing unchanged.
FBS_Group_Mapping.csv -filter -diff -merge -text
faostat_country_mapping.csv -filter -diff -merge -text
elasticity_supply.csv -filter -diff -merge -text
elasticity_demand.csv -filter -diff -merge -text
child_energy_requirement_lookup.csv -filter -diff -merge -text

# Reference snapshots for the reproduction check. Small plain text, and the
# check is worthless if a clone cannot read them, so they are git blobs.
reference/*.csv -filter -diff -merge -text

# Survivor emissions with OECD factors, written by consumption_ghg.py. It is a
# required pipeline input that a clean clone cannot rebuild, because the UN WPP
# workbook it depends on is not redistributed here. Same reasoning as above:
# stored as a blob so it survives a clone made without LFS.
"mortality model total emissions_oecd.csv" -filter -diff -merge -text

# Survival weights for the food shock, written by survival_weighting.py. Same
# reasoning: compute_food_savings raises without it, so it must survive a clone
# made without LFS. Small (about 106 KB) and plain text.
data_result/food_shock_survival_weight.csv -filter -diff -merge -text
